# Environment variables for StudyRAG Backend
# Copy this file to .env and fill in your values

# ---- PostgreSQL Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studyrag
DB_USER=postgres
DB_PASSWORD=your_password_here

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# ---- File Upload ----
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# ---- RAG Chunking ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
